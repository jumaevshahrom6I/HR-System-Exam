APP_ENV=local
LOG_LEVEL=debug
LOG_FILE=app.log

HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=10s

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hr
POSTGRES_PASSWORD=hr
POSTGRES_DB=hr-db
POSTGRES_SSLMODE=disable

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# Шаблон. Настоящий секрет только в .env (openssl rand -hex 32)
JWT_SECRET=super_secret_random_string_here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h